# Run python3 scripts/setup_env.py to create .env with a random administrator password.
PUBLIC_URL=http://localhost:8765
APP_PORT=8765
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-random-password-at-least-10-characters
WORKER_CONCURRENCY=1
MAX_ITEMS=200
MAX_FILE_MB=300
USER_QUOTA_MB=5120
JOB_TIMEOUT_SECONDS=3600
